{
  "name": "strata",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "deploy": "npm run lint:fix && npm run format && npm run build && gh-pages -d dist",
    "preview": "vite preview",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.8",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.69.0",
    "oxfmt": "^0.56.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}